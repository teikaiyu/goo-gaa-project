{
  "manifest_version": 3,
  "name": "Lumo",
  "version": "0.3.0",
  "description": "Lumo のタイマーと、集中中に SNS を開くと出てくる Lumo。拡張機能のボタンから始めます。",
  "key": "",
  "icons": {
    "128": "lumo/Lumo_smile.png"
  },
  "action": {
    "default_title": "Lumo を開く",
    "default_icon": {
      "128": "lumo/Lumo_smile.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "identity"
  ],
  "host_permissions": [
    "https://*.run.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "https://*.run.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
